# Copy to .env and adjust. Never commit the real .env.

# Flask session signing key. Generate: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me

# Set the initial admin password. If omitted, a random one is printed to the
# console on first run.
# ADMIN_PASSWORD=

# Enable the Werkzeug debugger (1 = on). Never enable in production.
FLASK_DEBUG=0

# SQLAlchemy database URI.
# DATABASE_URI=sqlite:///app_data.db

# Override how the Go scanner is launched (default: prebuilt binary or `go run`).
# SCANNER_BIN=/app/tools/scanner/scanner
